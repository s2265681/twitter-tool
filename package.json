                "https://*.twitter.com/*",
                "https://*.x.com/*"
            ],
            "resources": [
              "icon16.plasmo.6c567d50.png",
              "icon32.plasmo.76b92899.png",
              "icon48.plasmo.aced7582.png",
              "icon64.plasmo.8bb5e6e0.png",
